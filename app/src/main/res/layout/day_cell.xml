        <TextView android:id="@+id/holiday_dot" android:layout_width="8dp" android:layout_height="12dp" android:gravity="center" android:text="&#x2022;" android:textSize="10sp" />
        <TextView android:id="@+id/event_dot" android:layout_width="8dp" android:layout_height="12dp" android:gravity="center" android:text="&#x2022;" android:textSize="10sp" />
        <TextView android:id="@+id/task_dot" android:layout_width="8dp" android:layout_height="12dp" android:gravity="center" android:text="&#x2022;" android:textSize="10sp" />
